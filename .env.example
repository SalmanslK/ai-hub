# The local environment's values, read by compose.yaml. Copy this file to .env (git-ignored)
# and replace every CHANGE_ME / REPLACE_ value; never commit .env.

# The commit of the image to run: the tag `docker build -t ai-hub:$(git rev-parse --short HEAD) .` gave it.
AI_HUB_TAG=REPLACE_WITH_COMMIT

# The host port the app answers on (http://localhost:<port>).
AI_HUB_PORT=8080

# The PostgreSQL database, its user and its password; the app's connection string is built from them.
POSTGRES_DB=aihub
POSTGRES_USER=aihub
POSTGRES_PASSWORD=CHANGE_ME
